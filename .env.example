# Set through your host's secret settings. Never commit real values.
DASHBOARD_PASSWORD=
APP_ORIGIN=http://localhost:3000
HOST=127.0.0.1
PORT=3000
BRAIN_REPO=
BRAIN_BRANCH=main
# Fine-grained token restricted to the private vault; Contents read/write.
GITHUB_TOKEN=
# Optional JSON source array: {id,domain,label,path}; domains australia|paige|life.
# BRAIN_SOURCES=[]
# Synthetic demo only. Every GitHub write is disabled.
DASHBOARD_DEMO=0
# Start with read-only access while verifying the connection.
BRAIN_READ_ONLY=1
